{
  "crons": [
    {
      "path": "/api/schedule",
      "schedule": "0 8-23 * * *"
    }
  ],
  "functions": {
    "api/campaigns/**": {
      "maxDuration": 45,
      "memory": 1024,
      "bodyLimit": "4.5mb"
    },
    "api/upload.js": {
      "maxDuration": 45,
      "memory": 1024,
      "includeFiles": "api/node_modules/@vercel/blob/**"
    }
  }
}
