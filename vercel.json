{
  "crons": [
    {
      "path": "/api/cron/linkedin",
      "schedule": "0 8-23 * * *"
    },
    {
      "path": "/api/cron/linkedin-analytics",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "api/upload-client.js": {
      "includeFiles": "api/node_modules/@vercel/blob/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/image-proxy",
      "destination": "/api/image-proxy.js"
    }
  ]
}
